[Unit]
Description="MaBinouze.fr API"
Wants=postgresql.service

[Service]
Type=simple
User=mabinouze
Group=mabinouze
UMask=0111
RuntimeDirectoryMode=0755
RuntimeDirectory=mabinouze
WorkingDirectory=/opt/mabinouze/
ExecStart=/opt/mabinouze/mabinouze --socket /run/mabinouze/api.sock
KillSignal=SIGQUIT

[Install]
WantedBy=multi-user.target